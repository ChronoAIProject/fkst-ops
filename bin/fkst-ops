#!/usr/bin/env bash
set -euo pipefail

PYTHON="${FKST_OPS_PYTHON:-python3}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
usage() {
  local actions="ACTION"
  if declare -p FKST_OPS_PUBLIC_ACTIONS >/dev/null 2>&1; then
    actions="$(IFS='|'; echo "${FKST_OPS_PUBLIC_ACTIONS[*]}")"
  fi
  echo "usage: fkst-ops [preflight] [--deployment-dir PATH] --declaration PATH --machine-config PATH [--lock PATH] [$actions] [args...]" >&2
  echo "stop: sends SIGKILL; 'stop all' attempts every target and exits nonzero if any target fails; recovery uses durable state" >&2
}

original_argv=("$@")
preflight=0
[ "${1:-}" = preflight ] && { preflight=1; shift; }
declaration="" deployment_root="" machine="" lock=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --deployment-dir) [ "$#" -ge 2 ] || { usage; exit 2; }; deployment_root="$2"; shift 2 ;;
    --declaration) [ "$#" -ge 2 ] || { usage; exit 2; }; declaration="$2"; shift 2 ;;
    --machine-config|--machine-profile) [ "$#" -ge 2 ] || { usage; exit 2; }; machine="$2"; shift 2 ;;
    --lock) [ "$#" -ge 2 ] || { usage; exit 2; }; lock="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ -n "$declaration" ] && [ -n "$machine" ] || { usage; exit 2; }
if [ -z "$deployment_root" ]; then
  deployment_root="$(cd "$(dirname "$declaration")" 2>/dev/null && pwd)" || {
    echo "error: cannot locate declaration directory for $declaration" >&2
    exit 1
  }
  while [ ! -f "$deployment_root/fkst.lock" ]; do
    parent="$(dirname "$deployment_root")"
    if [ "$parent" = "$deployment_root" ]; then
      echo "error: no deployment root containing fkst.lock found above declaration $declaration" >&2
      exit 1
    fi
    deployment_root="$parent"
  done
fi
deployment_root="$(cd "$deployment_root" && pwd)"
[ -n "$lock" ] || lock="${FKST_OPS_LOCK_FILE:-$deployment_root/fkst.lock}"

read_pin() {
  "$PYTHON" - "$lock" <<'PY'
import re
import sys
import tomllib
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = tomllib.loads(path.read_text(encoding="utf-8"))
except (OSError, tomllib.TOMLDecodeError) as exc:
    print(f"error: cannot read fkst lockfile {path}: {exc}", file=sys.stderr)
    raise SystemExit(1)
sources = data.get("external_source", [])
if isinstance(sources, dict):
    sources = [sources]
for source in sources:
    if source.get("id") != "fkst-ops":
        continue
    revision = source.get("resolved", {}).get("rev")
    url = source.get("git")
    if not isinstance(revision, str) or not re.fullmatch(r"[0-9a-f]{40}", revision):
        print("error: fkst-ops lock entry needs resolved.rev as a full lowercase git SHA", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(url, str) or not url or "\t" in url or "\n" in url:
        print("error: fkst-ops lock entry needs git", file=sys.stderr)
        raise SystemExit(1)
    print(url, revision, sep="\t")
    raise SystemExit(0)
print("error: fkst.lock is missing external_source(id=fkst-ops)", file=sys.stderr)
raise SystemExit(1)
PY
}

checkout_at_revision() {
  "$PYTHON" - "$1" "$2" <<'PY'
import subprocess
import sys
from pathlib import Path

root, revision = Path(sys.argv[1]), sys.argv[2]
git_env = {"PATH": "/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM": "1", "HOME": "/dev/null"}

try:
    head_result = subprocess.run(
        ["git", "-c", "core.hooksPath=/dev/null", "-C", str(root), "rev-parse", "HEAD"],
        env=git_env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )
    head = head_result.stdout.decode("ascii").strip() if head_result.returncode == 0 else ""
    if head != revision:
        print(
            f"error: fkst-ops resolved.rev mismatch: expected {revision}, got {head or 'missing'}",
            file=sys.stderr,
        )
        raise SystemExit(1)
except OSError as exc:
    print(f"error: cannot inspect fkst-ops checkout: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
}

replace_pointer() {
  "$PYTHON" - "$1" "$2" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY
}

IFS=$'\t' read -r repo_url revision < <(read_pin)
if ! checkout_at_revision "$ROOT" "$revision" 2>/dev/null; then
  if [ "${FKST_OPS_REEXEC_DEPTH:-0}" != 0 ]; then
    echo "error: fkst-ops re-exec target is not the physically pinned checkout" >&2
    exit 1
  fi
  cache_root="${FKST_OPS_CACHE_ROOT:-$deployment_root/.fkst/run/fkst-ops}"
  mkdir -p "$cache_root/checkouts"
  current="$cache_root/current"
  candidate=""
  publish_lock=""
  cleanup() {
    [ -z "$candidate" ] || rm -rf "$candidate"
    [ -z "$publish_lock" ] || rmdir "$publish_lock" 2>/dev/null || true
  }
  trap cleanup EXIT

  if [ -L "$current" ] && cached="$(readlink "$current")" && [ -d "$cached/.git" ]; then
    checkout_at_revision "$cached" "$revision" 2>/dev/null &&
      FKST_OPS_REEXEC_DEPTH=1 exec "$cached/bin/fkst-ops" "${original_argv[@]}"
  fi

  verified="$cache_root/checkouts/$revision"
  if [ -e "$verified" ]; then
    checkout_at_revision "$verified" "$revision" || exit 1
    if [ "$preflight" -eq 1 ]; then
      FKST_OPS_REEXEC_DEPTH=1 "$verified/bin/fkst-ops" "${original_argv[@]}"
      exit 0
    fi
    FKST_OPS_REEXEC_DEPTH=1 "$verified/bin/fkst-ops" preflight "${original_argv[@]}"
    pointer="$cache_root/.current.$$"
    ln -s "$verified" "$pointer"
    replace_pointer "$pointer" "$current"
    FKST_OPS_REEXEC_DEPTH=1 exec "$verified/bin/fkst-ops" "${original_argv[@]}"
  fi

  candidate="$(mktemp -d "$cache_root/checkouts/.partial.XXXXXX")"
  git clone --quiet --no-checkout "$repo_url" "$candidate"
  git -C "$candidate" checkout --quiet "$revision"
  checkout_at_revision "$candidate" "$revision" || exit 1
  if [ "$preflight" -eq 1 ]; then
    FKST_OPS_REEXEC_DEPTH=1 "$candidate/bin/fkst-ops" "${original_argv[@]}"
  else
    FKST_OPS_REEXEC_DEPTH=1 "$candidate/bin/fkst-ops" preflight "${original_argv[@]}"
  fi

  publish_lock="$verified.publish-lock"
  if ! mkdir "$publish_lock"; then
    echo "error: fkst-ops checkout publication already in progress: $verified" >&2
    exit 1
  fi
  if [ -e "$verified" ]; then
    checkout_at_revision "$verified" "$revision" || exit 1
    rm -rf "$candidate"
    candidate=""
  else
    mv "$candidate" "$verified"
    candidate=""
  fi
  rmdir "$publish_lock"
  publish_lock=""
  pointer="$cache_root/.current.$$"
  ln -s "$verified" "$pointer"
  replace_pointer "$pointer" "$current"
  [ "$preflight" -eq 0 ] || exit 0
  FKST_OPS_REEXEC_DEPTH=1 exec "$verified/bin/fkst-ops" "${original_argv[@]}"
fi

source "$ROOT/ops/public_actions.sh"
export FKST_OPS_DECLARATION="$declaration"
export FKST_OPS_MACHINE_PROFILE="$machine"
export FKST_OPS_LOCK="$lock"
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -P -m schema.validator "$declaration" "$machine" "$lock" >/dev/null
[ "$preflight" -eq 0 ] || exit 0

action="${1:-status}"
shift || true
for public_action in "${FKST_OPS_PUBLIC_ACTIONS[@]}"; do
  if [ "$action" = "$public_action" ]; then
    exec "$ROOT/ops/deployment_operator.sh" "$action" "$@"
  fi
done
[ "$action" = doctor ] && exec "$ROOT/doctor/doctor.sh" "$@"
usage
exit 2
